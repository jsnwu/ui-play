{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["rest/**/*.ts", "browser/**/*.ts", "textplay/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
